---
import { Image } from 'astro:assets';
import SiteHeader from '../navigation/SiteHeader.astro';
import portrait from '../../assets/home/portrait.png';
import type { hero } from '../../data/home';

type Props = typeof hero;

const { headline, highlight, bio, word } = Astro.props;
---

<section data-theme="red" class="grid overflow-clip pt-3.5">
	<div class="relative z-10 xl:col-start-1 xl:row-start-1">
		<SiteHeader />
		<div class="wrapper flex flex-col gap-md pt-10 md:pt-[74px]">
			<h1 class="text-headline">
				{headline.map((line) => <span class="block">{line}</span>)}
				<span class="block text-paper">{highlight}</span>
			</h1>
			<p class="max-w-150 text-body-lg xl:max-w-[min(600px,calc(49vw-var(--layout-margin)-2rem))]">{bio}</p>
		</div>
	</div>

	<div
		class="relative mx-auto mt-2xl h-[2.088em] w-full max-w-frame text-giant whitespace-nowrap select-none xl:col-start-1 xl:row-start-1 xl:mt-[125px]"
	>
		<p aria-hidden="true" class="absolute top-[1em] left-[-0.046em]">{word}</p>
		<Image
			src={portrait}
			alt="Harold Coronado"
			widths={[400, 709, 1418]}
			sizes="(min-width: 1720px) 709px, 41vw"
			loading="eager"
			class="hero-pin absolute top-0 left-[1.638em] size-[1.3635em] rounded-full mix-blend-multiply"
		/>
		<div aria-hidden="true" class="hero-pin absolute top-0 left-[1.638em] size-[1.3635em] overflow-hidden rounded-full">
			<p class="hero-unpin absolute top-[1em] left-[-1.684em] text-paper">{word}</p>
		</div>
	</div>
</section>

<style is:global>
	@keyframes hero-pin {
		to {
			translate: 0 100000px;
		}
	}

	@keyframes hero-unpin {
		to {
			translate: 0 -100000px;
		}
	}

	@media (prefers-reduced-motion: no-preference) and (min-width: 80rem) {
		@supports (animation-timeline: scroll()) {
			.hero-pin,
			.hero-unpin {
				animation: hero-pin linear both;
				animation-timeline: scroll(root);
				animation-range: 0px 100000px;
			}

			.hero-unpin {
				animation-name: hero-unpin;
			}
		}
	}
</style>
