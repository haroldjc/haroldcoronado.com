---
import { Image } from 'astro:assets';
import SiteHeader from '../navigation/SiteHeader.astro';
import portrait from '../../assets/home/portrait.png';
import type * as home from '../../data/home';
import type { Lang } from '../navigation/types';

type Props = typeof home.hero & { contact: (typeof home.contact)['links'][number]; lang?: Lang };

const { headline, highlight, bio, words, fitTo, contact, lang } = Astro.props;
---

<section data-hero data-theme="red" class="grid overflow-clip lg:pt-3.5">
	<div class="relative z-10 xl:col-start-1 xl:row-start-1">
		<SiteHeader contact={contact} lang={lang} />
		<div class="wrapper flex flex-col gap-md pt-10 md:pt-[74px]">
			<h1 data-roll class="text-headline">
				{headline.map((line) => <span class="block">{line}{' '}</span>)}
				<span class="block text-paper">{highlight}</span>
			</h1>
			<p class="max-w-150 text-body-lg xl:max-w-[min(600px,calc(49vw-var(--layout-margin)-2rem))]">{bio}</p>
		</div>
	</div>

	<div
		class="relative mx-auto mt-2xl h-[2.088em] w-full max-w-frame text-giant whitespace-nowrap select-none xl:col-start-1 xl:row-start-1 xl:mt-[125px]"
	>
		<p aria-hidden="true" class="hero-words absolute top-[1em] left-[-0.046em] grid" data-fit-to={fitTo}>
			{words.map((word, i) => <span class="hero-word" data-state={i === 0 ? 'in' : undefined}>{[...word].map((letter, j) => <span style={`--i: ${j}`}>{letter}</span>)}</span>)}
		</p>
		<Image
			src={portrait}
			alt="Harold Coronado"
			widths={[400, 709, 1418]}
			sizes="(min-width: 1720px) 709px, 41vw"
			loading="eager"
			class="hero-pin absolute top-0 left-[1.638em] size-[1.3635em] rounded-full mix-blend-multiply"
		/>
		<div aria-hidden="true" class="hero-pin absolute top-0 left-[1.638em] size-[1.3635em] overflow-hidden rounded-full">
			<p class="hero-words hero-unpin absolute top-[1em] left-[-1.684em] grid text-paper">
				{words.map((word, i) => <span class="hero-word" data-state={i === 0 ? 'in' : undefined}>{[...word].map((letter, j) => <span style={`--i: ${j}`}>{letter}</span>)}</span>)}
			</p>
		</div>
	</div>
</section>

<script>
	const groups = document.querySelectorAll<HTMLElement>('.hero-words');
	const count = groups[0]?.children.length ?? 0;
	const WORD_INTERVAL: number = 5200;

	function fit() {
		const [measure] = groups;
		if (!measure?.dataset.fitTo) return;
		const ruler = document.createElement('span');
		const baseline = document.createElement('span');
		ruler.style.cssText = 'position: absolute; visibility: hidden';
		baseline.style.display = 'inline-block';
		ruler.append(measure.dataset.fitTo, baseline);
		measure.append(ruler);
		const fontSize = parseFloat(getComputedStyle(measure).fontSize);
		const origin = (baseline.getBoundingClientRect().top - ruler.getBoundingClientRect().top) / fontSize;
		const target = ruler.getBoundingClientRect().width;
		const words = [...measure.children].filter((word) => word !== ruler) as HTMLElement[];
		const scales = words.map((word) => target / word.offsetWidth);
		ruler.remove();
		for (const group of groups) {
			group.style.setProperty('--baseline', `${origin}em`);
			[...group.children].forEach((word, i) => ((word as HTMLElement).style.scale = String(scales[i])));
		}
	}

	fit();
	document.fonts.ready.then(fit);

	if (count > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let current = 0;
		let timer = 0;

		const schedule = () => {
			clearTimeout(timer);
			timer = window.setTimeout(advance, WORD_INTERVAL);
		};

		const advance = () => {
			const next = (current + 1) % count;
			for (const group of groups) {
				const incoming = group.children[next] as HTMLElement;
				delete incoming.dataset.state;
				void incoming.offsetWidth;
				(group.children[current] as HTMLElement).dataset.state = 'out';
				incoming.dataset.state = 'in';
			}
			current = next;
			schedule();
		};

		document.addEventListener('visibilitychange', () => (document.hidden ? clearTimeout(timer) : schedule()));
		schedule();
	}
</script>

<style is:global>
	.hero-word {
		grid-area: 1 / 1;
		justify-self: start;
		transform-origin: 0 var(--baseline);
		clip-path: inset(-1em -0.5em -0.25em);
	}

	.hero-word > span {
		display: inline-block;
		translate: 0 150%;
	}

	.hero-word[data-state='in'] > span {
		translate: 0;
		transition: translate 900ms cubic-bezier(0.22, 1, 0.36, 1) calc(200ms + var(--i) * 40ms);
	}

	.hero-word[data-state='out'] > span {
		translate: 0 -50%;
		opacity: 0;
		transition:
			translate 500ms cubic-bezier(0.64, 0, 0.78, 0) calc(var(--i) * 40ms),
			opacity 350ms ease-out calc(var(--i) * 40ms);
	}

	@keyframes hero-pin {
		to {
			translate: 0 100000px;
		}
	}

	@keyframes hero-unpin {
		to {
			translate: 0 -100000px;
		}
	}

	@media (prefers-reduced-motion: no-preference) and (min-width: 80rem) {
		@supports (animation-timeline: scroll()) {
			.hero-pin,
			.hero-unpin {
				animation-name: hero-pin;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: scroll(root);
				animation-range: 0px 100000px;
			}

			.hero-unpin {
				animation-name: hero-unpin;
			}
		}
	}
</style>
