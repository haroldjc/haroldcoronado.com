---
import SectionName from '../content/SectionName.astro';
import type { contact } from '../../data/home';

type Props = Pick<typeof contact, 'headline'>;

const { headline } = Astro.props;
---

<section id="contact" data-theme="plum" aria-labelledby="contact-title" class="py-section">
	<div class="wrapper flex flex-col gap-lg">
		<SectionName label="contact" />
		<h2 id="contact-title" class="-ml-[0.055em] text-display">
			{headline.map((line) => <span class="block">{line}</span>)}
		</h2>
	</div>
</section>
