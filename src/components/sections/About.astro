---
import Constellation from '../about-graphics/Constellation.astro';
import ContentItem from '../content/ContentItem.astro';
import RichText from '../content/RichText.astro';
import SectionName from '../content/SectionName.astro';
import type { about } from '../../data/home';
import type { Lang } from '../navigation/types';

type Props = typeof about & { lang?: Lang };

const { label, headline, note, intro, items, lang } = Astro.props;
---

<section data-theme="paper" aria-labelledby="about-title" class="overflow-x-clip">
	<Constellation lang={lang} />

	<div id="about" class="wrapper flex flex-col gap-4xl py-section">
		<div class="flex flex-col gap-lg">
			<SectionName label={label} />
			<div class="layout-grid gap-y-lg">
				<h2 id="about-title" data-roll class="col-span-full text-headline text-teal md:col-span-8">
					{headline.map((line) => <span class="block">{line}{' '}</span>)}
				</h2>
				<p data-roll class="col-span-full text-heading font-medium md:col-span-4 md:pt-5">
					{note.map((line) => <span class="block">{line}{' '}</span>)}
				</p>
			</div>
		</div>
		<div class="layout-grid gap-y-3xl">
			<RichText value={intro} class="col-span-full text-body-lg md:col-span-6" />
			<div class="col-span-full grid gap-2xl sm:grid-cols-2 md:col-span-6 md:pt-1.5">
				{items.map((item) => <ContentItem {...item} />)}
			</div>
		</div>
	</div>
</section>
