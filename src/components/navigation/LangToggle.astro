---
import { homeHrefs, type Lang, type LangHrefs, ui } from './types';

type Props = {
	current?: Lang;
	hrefs?: LangHrefs;
	class?: string;
};

const { current = 'en', hrefs = homeHrefs, class: className } = Astro.props;
const langs: { code: Lang; name: string }[] = [
	{ code: 'en', name: 'English' },
	{ code: 'es', name: 'Español' },
];
---

<nav aria-label={ui[current].language} class:list={['flex shrink-0 border border-default', className]}>
	{
		langs.map(({ code, name }) => (
			<a
				href={hrefs[code]}
				hreflang={code}
				lang={code}
				aria-label={name}
				aria-current={code === current ? 'true' : undefined}
				class:list={[
					'px-sm py-2xs text-label no-underline',
					code === current
						? 'bg-inverse text-on-inverse'
						: 'text-primary transition-colors duration-450 ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-segment-hover hover:text-accent',
				]}
			>
				{code}
			</a>
		))
	}
</nav>
