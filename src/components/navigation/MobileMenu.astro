---
import Wordmark from '../brand/Wordmark.astro';
import IconButton from '../ui/IconButton.astro';
import LangToggle from './LangToggle.astro';
import { defaultNav, type Lang, type LangHrefs, type NavItem } from './types';

type Props = {
	id?: string;
	links?: NavItem[];
	current?: string;
	lang?: Lang;
	langHrefs?: LangHrefs;
	contact?: NavItem;
	theme?: 'paper' | 'red' | 'teal' | 'plum';
};

const { id = 'mobile-menu', links = defaultNav, current, lang, langHrefs, contact, theme = 'paper' } = Astro.props;
---

<dialog
	id={id}
	aria-label="Menu"
	tabindex="-1"
	data-theme={theme}
	class="mobile-menu fixed inset-0 m-0 size-full max-h-none max-w-none flex-col justify-between bg-surface px-margin pt-(--menu-top) pb-margin text-primary inset-ring inset-ring-(--color-border-subtle) focus:outline-none open:flex"
>
	<div class="flex flex-col">
		<div class="flex h-20 items-center justify-between">
			<Wordmark href="/" />
			<form method="dialog">
				<IconButton type="submit" icon="close" label="Close menu" />
			</form>
		</div>
		<nav aria-label="Main" class="pt-xl">
			<ul role="list">
				{
					links.map((link) => (
						<li class="border-t border-default py-md">
							<a
								href={link.href}
								aria-current={link.href === current ? 'page' : undefined}
								class="text-title whitespace-nowrap text-primary no-underline"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
	<div class="flex items-center justify-between">
		<LangToggle current={lang} hrefs={langHrefs} />
		{
			contact && (
				<a href={contact.href} class="text-info whitespace-nowrap text-primary no-underline">
					{contact.label}
				</a>
			)
		}
	</div>
</dialog>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-menu-open]').forEach((button) => {
		const dialog = document.getElementById(button.dataset.menuOpen ?? '');
		if (!(dialog instanceof HTMLDialogElement)) return;
		button.addEventListener('click', () => {
			const row = button.closest('header')?.offsetHeight ?? 0;
			const top = button.getBoundingClientRect().top - (row - button.offsetHeight) / 2;
			dialog.style.setProperty('--menu-top', `${Math.max(top, 0)}px`);
			dialog.showModal();
			dialog.focus();
		});
		dialog.querySelectorAll('nav a').forEach((link) => link.addEventListener('click', () => dialog.close()));
	});
</script>

<style>
	.mobile-menu {
		translate: 0 -100%;
		transition-property: translate, display, overlay;
		transition-behavior: allow-discrete;
		transition-duration: 300ms;
		transition-timing-function: cubic-bezier(0.7, 0, 0.84, 0);
	}

	.mobile-menu[open] {
		translate: 0 0;
		transition-duration: 450ms;
		transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);

		@starting-style {
			translate: 0 -100%;
		}
	}
</style>
