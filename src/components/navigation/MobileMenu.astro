---
import Wordmark from '../brand/Wordmark.astro';
import IconButton from '../ui/IconButton.astro';
import TextLink from '../ui/TextLink.astro';
import LangToggle from './LangToggle.astro';
import { type Lang, type LangHrefs, type NavItem, navLinks, ui } from './types';

type Props = {
	id?: string;
	links?: NavItem[];
	current?: string;
	lang?: Lang;
	langHrefs?: LangHrefs;
	contact?: NavItem & { external?: boolean };
};

const { id = 'mobile-menu', lang = 'en', links = navLinks[lang], current, langHrefs, contact } = Astro.props;
---

<dialog
	id={id}
	aria-label={ui[lang].menu}
	tabindex="-1"
	data-theme="ink"
	class="mobile-menu fixed inset-0 m-0 size-full max-h-none max-w-none flex-col justify-between bg-surface px-margin pt-md pb-margin text-primary focus:outline-none open:flex"
>
	<div class="flex flex-col gap-2xl">
		<div class="flex items-center justify-between">
			<Wordmark href="/" />
			<form method="dialog">
				<IconButton type="submit" icon="close" label={ui[lang].closeMenu} />
			</form>
		</div>
		<nav aria-label={ui[lang].main}>
			<ul role="list">
				{
					links.map((link) => (
						<li class="border-t border-default py-md">
							<a
								href={link.href}
								aria-current={link.href === current ? 'page' : undefined}
								class="text-title whitespace-nowrap text-primary no-underline"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
	<div class="flex items-center justify-between">
		<LangToggle current={lang} hrefs={langHrefs} />
		{
			contact && (
				<TextLink href={contact.href} size="medium" external={contact.external}>
					{contact.label}
				</TextLink>
			)
		}
	</div>
</dialog>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-menu-open]').forEach((button) => {
		const dialog = document.getElementById(button.dataset.menuOpen ?? '');
		if (!(dialog instanceof HTMLDialogElement)) return;
		button.addEventListener('click', () => {
			dialog.showModal();
			dialog.focus();
		});
		dialog.querySelectorAll('nav a').forEach((link) => link.addEventListener('click', () => dialog.close()));
	});
</script>

<style>
	.mobile-menu {
		translate: 0 -100%;
		transition-property: translate, display, overlay;
		transition-behavior: allow-discrete;
		transition-duration: 300ms;
		transition-timing-function: cubic-bezier(0.7, 0, 0.84, 0);
	}

	.mobile-menu[open] {
		translate: 0 0;
		transition-duration: 450ms;
		transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);

		@starting-style {
			translate: 0 -100%;
		}
	}
</style>
