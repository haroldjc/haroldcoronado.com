---
type Props = {
	href: string;
	current?: boolean;
	class?: string;
};

const { href, current = false, class: className } = Astro.props;
---

<a
	href={href}
	aria-current={current ? 'page' : undefined}
	class:list={['link-line text-info whitespace-nowrap text-primary no-underline [--rest-size:0px]', current && '[--line-width:100%]', className]}
>
	<slot />
</a>
