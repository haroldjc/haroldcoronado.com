---
import Wordmark from '../brand/Wordmark.astro';
import IconButton from '../ui/IconButton.astro';
import FloatingNav from './FloatingNav.astro';
import LangToggle from './LangToggle.astro';
import MobileMenu from './MobileMenu.astro';
import NavLink from './NavLink.astro';
import { type Lang, type LangHrefs, type NavItem, navLinks, ui } from './types';

type Props = {
	links?: NavItem[];
	current?: string;
	lang?: Lang;
	langHrefs?: LangHrefs;
	contact?: NavItem & { external?: boolean };
	class?: string;
};

const { lang = 'en', links = navLinks[lang], current, langHrefs, contact, class: className } = Astro.props;
---

<header class:list={['wrapper flex h-20 items-center justify-between', className]}>
	<Wordmark href="/" />
	<div class="flex items-center gap-md md:gap-2xl">
		<nav aria-label={ui[lang].main} class="hidden md:block">
			<ul role="list" class="flex gap-xl">
				{
					links.map((link) => (
						<li>
							<NavLink href={link.href} current={link.href === current}>
								{link.label}
							</NavLink>
						</li>
					))
				}
			</ul>
		</nav>
		<LangToggle current={lang} hrefs={langHrefs} />
		<span class="size-12 md:hidden">
			<IconButton
				icon="menu"
				label={ui[lang].openMenu}
				data-menu-open="mobile-menu"
				aria-haspopup="dialog"
				class="fixed top-4 right-margin z-40"
			/>
		</span>
	</div>
	<MobileMenu id="mobile-menu" links={links} current={current} lang={lang} langHrefs={langHrefs} contact={contact} />
	<FloatingNav links={links} current={current} lang={lang} langHrefs={langHrefs} contact={contact} />
</header>
