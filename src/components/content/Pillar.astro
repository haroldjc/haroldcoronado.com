---
type Props = {
	title: string;
	description: string;
	tools: string[];
	class?: string;
};

const { title, description, tools, class: className } = Astro.props;
---

<article class:list={['flex flex-col gap-md text-primary', className]}>
	<h3 class="text-title">{title}</h3>
	<p class="text-body">{description}</p>
	<ul role="list" class="text-body">
		{tools.map((tool) => <li>{tool}</li>)}
	</ul>
</article>
