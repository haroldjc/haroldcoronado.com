---
type Props = {
	quote: string;
	attribution?: string;
	class?: string;
};

const { quote, attribution, class: className } = Astro.props;
---

<figure class:list={['flex items-start gap-md', className]}>
	<span aria-hidden="true" class="shrink-0 text-headline text-red">“</span>
	<div class="flex min-w-0 flex-1 flex-col gap-lg pt-md">
		<blockquote class="text-heading text-primary">{quote}</blockquote>
		{attribution && <figcaption class="text-label text-secondary">{attribution}</figcaption>}
	</div>
</figure>
