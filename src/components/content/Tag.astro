---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'a'>, 'class'> & {
	label: string;
	href?: string;
	selected?: boolean;
	class?: string;
};

const { label, href, selected = false, class: className, ...attrs } = Astro.props;
const Element = href ? 'a' : 'span';
---

<Element
	href={href}
	aria-current={href && selected ? 'page' : undefined}
	class:list={[
		'inline-flex border border-default px-sm py-2xs text-label whitespace-nowrap no-underline',
		selected ? 'bg-inverse text-on-inverse' : 'text-primary',
		className,
	]}
	{...attrs}
>
	{label}
</Element>
