---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'svg'> & { size?: number };

const { size = 24, ...attrs } = Astro.props;
const labelled = Boolean(attrs['aria-label'] || attrs['aria-labelledby']);
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={48 / size}
	stroke-linecap="square"
	role={labelled ? 'img' : undefined}
	aria-hidden={labelled ? undefined : 'true'}
	{...attrs}
>
	<path d="M10.5 17C14.0899 17 17 14.0899 17 10.5C17 6.91015 14.0899 4 10.5 4C6.91015 4 4 6.91015 4 10.5C4 14.0899 6.91015 17 10.5 17Z" />
	<path d="M15.5 15.5L20 20" />
</svg>
