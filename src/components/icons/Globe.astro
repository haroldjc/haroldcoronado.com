---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'svg'> & { size?: number };

const { size = 24, ...attrs } = Astro.props;
const labelled = Boolean(attrs['aria-label'] || attrs['aria-labelledby']);
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={48 / size}
	stroke-linecap="square"
	role={labelled ? 'img' : undefined}
	aria-hidden={labelled ? undefined : 'true'}
	{...attrs}
>
	<path d="M12 21C16.9706 21 21 16.9706 21 12C21 7.02944 16.9706 3 12 3C7.02944 3 3 7.02944 3 12C3 16.9706 7.02944 21 12 21Z" />
	<path d="M3 12H21M12 3C9 6.5 9 17.5 12 21C15 17.5 15 6.5 12 3Z" />
</svg>
