---
type Props = {
	href: string;
	size?: 'large' | 'medium' | 'small' | 'inline';
	external?: boolean;
	class?: string;
};

const { href, size = 'large', external = false, class: className } = Astro.props;

const sizes = {
	large: 'text-title [--line-offset:0px] [--line-size:3px] [--rest-offset:1px] [--rest-size:2px]',
	medium: 'text-info',
	small: 'text-label',
	inline: '',
};
---

<a
	href={href}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
	class:list={['link-line no-underline', size !== 'inline' && 'inline-flex whitespace-nowrap text-primary', sizes[size], className]}
>
	<slot />
</a>
