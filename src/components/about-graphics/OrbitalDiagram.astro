---
type Props = {
	planets: string[];
	class?: string;
};

const { planets, class: className } = Astro.props;

const width = 1720;
const height = 1220;
const sun = { cx: -120, cy: 600, r: 520 };
const orbits = [720, 930, 1160, 1400, 1640];
const bodies = [
	{ cx: 538, cy: 307, r: 56, fill: 'fill-teal', label: { x: 608, y: 298 } },
	{ cx: 782, cy: 825, r: 88, fill: 'fill-red', label: { x: 884, y: 816 } },
	{ cx: 931, cy: 110, r: 22, fill: 'fill-ink', label: { x: 967, y: 101 } },
	{ cx: 1196, cy: 1079, r: 44, fill: 'fill-plum', label: { x: 1254, y: 1070 } },
];
const percent = (value: number, total: number) => `${(value / total) * 100}%`;
---

<div class:list={['relative mx-auto aspect-1720/1220 max-w-frame overflow-y-clip', className]}>
	<svg viewBox={`0 0 ${width} ${height}`} aria-hidden="true" class="absolute inset-0 size-full overflow-visible">
		<circle cx={sun.cx} cy={sun.cy} r={sun.r} class="fill-red mix-blend-multiply" />
		{
			orbits.map((r) => (
				<circle cx={sun.cx} cy={sun.cy} r={r} fill="none" vector-effect="non-scaling-stroke" class="stroke-ink" />
			))
		}
		{bodies.map((body) => <circle cx={body.cx} cy={body.cy} r={body.r} class={body.fill} />)}
	</svg>
	<ul role="list" class="text-label">
		{
			bodies.map((body, i) => (
				<li class="absolute whitespace-nowrap" style={{ left: percent(body.label.x, width), top: percent(body.label.y, height) }}>
					{planets[i]}
				</li>
			))
		}
	</ul>
</div>
