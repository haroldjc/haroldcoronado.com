---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnnouncementBanner from '../components/navigation/AnnouncementBanner.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';
import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';
import Hero from '../components/sections/Hero.astro';
import Skills from '../components/sections/Skills.astro';
import Work from '../components/sections/Work.astro';
import { about, contact, hero, skills, work } from '../data/home';
import { getAnnouncement } from '../lib/announcement';

const announcement = await getAnnouncement();
---

<BaseLayout title="Harold Coronado" description={hero.bio}>
	{announcement && <AnnouncementBanner message={announcement.message} link={announcement.link} />}
	<main>
		<Hero {...hero} />
		<Skills {...skills} />
		<Work {...work} />
		<About {...about} />
		<Contact headline={contact.headline} />
	</main>
	<SiteFooter links={contact.links} />
</BaseLayout>
