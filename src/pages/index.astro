---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';
import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';
import Hero from '../components/sections/Hero.astro';
import Skills from '../components/sections/Skills.astro';
import Work from '../components/sections/Work.astro';
import { about, contact, hero, skills, work } from '../data/home';
---

<BaseLayout title="Harold Coronado" description={hero.bio}>
	<main>
		<Hero {...hero} />
		<Skills {...skills} />
		<Work {...work} />
		<About {...about} />
		<Contact headline={contact.headline} />
	</main>
	<SiteFooter links={contact.links} />
</BaseLayout>
