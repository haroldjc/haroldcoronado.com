---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	lang?: 'en' | 'es';
}

const { title, description, lang = 'en' } = Astro.props;
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		{description && <meta name="description" content={description} />}
		<title>{title}</title>
		<Font cssVariable="--font-inter" preload />
		<slot name="head" />
		<script is:inline>
			(() => {
				const key = 'lang-switch';
				const homes = ['/', '/es/'];
				const blocks = () => [...document.querySelectorAll('main > section, body > footer')];
				const clear = () =>
					document.querySelectorAll('[data-roll]').forEach((el) => {
						el.style.removeProperty('view-transition-name');
						el.style.removeProperty('view-transition-class');
					});
				const roll = (transition) => {
					document.querySelectorAll('[data-roll]').forEach((el, i) => {
						el.style.setProperty('view-transition-name', `roll-${i}`);
						el.style.setProperty('view-transition-class', 'roll');
					});
					transition.finished.finally(clear);
				};

				const restore = () => {
					const saved = sessionStorage.getItem(key);
					sessionStorage.removeItem(key);
					if (!saved || !homes.includes(location.pathname)) return false;
					const { index, ratio } = JSON.parse(saved);
					const block = blocks()[index];
					const top = block ? block.getBoundingClientRect().top + scrollY + ratio * block.offsetHeight : 0;
					scrollTo({ top, behavior: 'instant' });
					return true;
				};

				document.addEventListener('click', (event) => {
					const link = event.target.closest?.('a[hreflang]');
					const to = link && new URL(link.href).pathname;
					if (!to || to === location.pathname || !homes.includes(to) || !homes.includes(location.pathname)) return;
					const all = blocks();
					const index = all.findLastIndex((block) => block.getBoundingClientRect().top <= 0);
					const rect = all[index]?.getBoundingClientRect();
					sessionStorage.setItem(key, JSON.stringify({ index, ratio: rect ? -rect.top / rect.height : 0 }));
				});

				addEventListener('pageswap', (event) => {
					if (!event.viewTransition) return;
					if (sessionStorage.getItem(key)) roll(event.viewTransition);
					else event.viewTransition.skipTransition();
				});

				if ('onpagereveal' in window) {
					addEventListener('pagereveal', (event) => {
						clear();
						if (!event.viewTransition) restore();
						else if (restore()) roll(event.viewTransition);
						else event.viewTransition.skipTransition();
					});
				} else {
					addEventListener('DOMContentLoaded', restore);
				}
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
